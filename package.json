{
  "name": "class-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:prolog": "tsx prolog/runner.ts",
    "test:playwright": "npx playwright test",
    "test": "npm run test:prolog && npm run test:playwright",
    "issue": "tsx scripts/new-issue.ts",
    "typecheck:ts7": "node node_modules/typescript-7/bin/tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@material-design-icons/font": "^0.14.15",
    "change-case": "^5.4.4",
    "js-base64": "^3.7.8",
    "lz-string": "^1.5.0",
    "swipl-wasm": "^7.0.10",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.0.12",
    "vite-plugin-static-copy": "^4.1.0",
    "vue-tsc": "^3.3.11"
  }
}
